# Supabase — copiază acest fișier în .env.local și completează valorile reale
# (Supabase Dashboard → Project Settings → API)

# Project URL, ex: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Cheia „anon public" (poate fi expusă în browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cheia „service_role" — SECRETĂ, folosită doar pe server (gestionare utilizatori).
# NU o pune niciodată într-o variabilă NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
